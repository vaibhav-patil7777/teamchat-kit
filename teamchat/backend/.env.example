# Copy to .env and edit. Local run works with NO .env at all (SQLite).
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=1
ALLOWED_HOSTS=*

# Admin account created by:  python manage.py create_admin
ADMIN_USERNAME=Vaibhav777
ADMIN_PASSWORD=Vaibhav@1455

# Production database (Neon):  postgresql://user:pass@host/db?sslmode=require
# DATABASE_URL=

# Allowed frontend origins (comma separated). Empty = allow all.
# CORS_ORIGINS=https://your-site.netlify.app

# Optional S3-compatible storage for uploads (Cloudflare R2 / Backblaze B2)
# S3_BUCKET=
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=auto
# S3_PUBLIC_BASE_URL=
